{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--config",
        ".playwright-mcp.config.json",
        "--secrets",
        ".env.playwright-secrets",
        "--output-dir",
        "evidence/.mcp-out"
      ]
    },
    "atlassian": {
      "type": "sse",
      "url": "https://mcp.atlassian.com/v1/sse"
    }
  }
}
