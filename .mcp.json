{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.84",
        "--config",
        ".playwright-mcp.config.json",
        "--secrets",
        ".env.playwright-secrets",
        "--output-dir",
        "evidence/.mcp-out",
        "--image-responses",
        "omit"
      ]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    }
  }
}
