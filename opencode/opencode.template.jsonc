// blueprint-version: 0.12.0
// opencode config template for the qa-agent-blueprint — merged into the
// consumer's opencode.json(c) by `install.sh --mode opencode`. Contract:
// docs/opencode-port-plan.md (D4 router via instructions, D5 tool-name
// mapping, D6 no model key, D8 absolute-path permission globs).
{
  "$schema": "https://opencode.ai/config.json",

  // The QA router + the always-loaded core rules. ROUTER.md is the CLAUDE.md
  // port; the core rules are shared with the Claude harness byte-identically
  // (the installer symlinks .claude/ into the consumer — see plan §7 D10).
  "instructions": [
    ".opencode/ROUTER.md",
    ".claude/rules/core/*.md"
  ],

  // qa-manager (subagent) spawns test-executor/test-automator (subagents) —
  // the default depth of 1 would break that chain.
  "subagent_depth": 2,

  // MCP contract: the server NAMES `playwright` and `atlassian` are load-bearing
  // (hooks and agents match on them — docs/rules/core/token-discipline.md).
  // Do not rename; do not add a second same-named server.
  "mcp": {
    "playwright": {
      "type": "local",
      // Contract flags: --config and --secrets are hard-fail on ENOENT, which
      // is why the plugin seeds both files on startup (bootstrap).
      // --image-responses omit keeps screenshots out of the context — they
      // land as evidence files in --output-dir and are read back on demand.
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--config",
        ".playwright-mcp.config.json",
        "--secrets",
        ".env.playwright-secrets",
        "--output-dir",
        "evidence/.mcp-out",
        "--image-responses",
        "omit"
      ]
    },
    "atlassian": {
      // Atlassian Cloud remote server (v2, HTTP transport — the v1 SSE
      // endpoint is sunset-bound); OAuth happens via the human /mcp-style
      // flow. The DEFAULT v2 URL exposes only the Primary tools directly
      // (getJiraIssue, createJiraIssue, editJiraIssue, transitionJiraIssue,
      // addOrEditJiraIssueComment, searchJiraIssuesUsingJql — the set this
      // blueprint calls) plus discover/executeRead/executeWrite for the
      // deferred catalogue — never append ?tools=all, which inflates the
      // tool surface of every session AND every subagent spawn with the
      // whole Atlassian suite. The guard treats executeWrite/executeDestructive
      // as writes (shadow gate). Data Center deployments replace THIS entry
      // with the local mcp-atlassian command — keeping the name `atlassian`
      // (AGENTS.md).
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    }
  },

  // Belt-and-braces with the pre-tool guard: opencode permission globs must
  // match ABSOLUTE paths (spike S4), hence the **/ prefix. The guard in
  // qa-blueprint.ts stays the strict layer; these denies keep reads of
  // secrets and writes of QA-internal evidence/audit data out of the loop.
  "permission": {
    "read": {
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      // last match wins — the committed placeholder template stays readable,
      // same exemption the pre-tool guard encodes.
      "**/.env.example": "allow"
    },
    "edit": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/evidence/.audit/**": "deny",
      "**/.env.example": "allow"
    }
  }

  // No "model"/"small_model" key on purpose (D6): the model is the user's
  // /models choice — the blueprint anchors nothing.
}
