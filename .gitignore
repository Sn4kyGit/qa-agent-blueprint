# QA Agent Blueprint

# Secrets — never committed
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# Evidence — local test artifacts, gitignored per docs/artifact-strategy.md
evidence/*
!evidence/README.md

# Local memory store, if you ever wire an external memory server yourself
# (not shipped — see docs/memory-layers.md)
memory/.mnemosyne/

# Eval runs (results are output, cases are source)
evals/results/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Installer backups
*.bak-*

# Spickzettel — lokale, druckfertige Team-Handouts, kein Repo-Inhalt
spickzettel-*.html
spickzettel-*.pdf

# Node
node_modules/

# OS
.DS_Store

# Claude Code local (machine-specific) settings — never committed
.claude/settings.local.json

# Python bytecode — a stray __pycache__/ next to a skill makes the installer
# report that skill as a collision (see tc-history.py).
__pycache__/
*.pyc
